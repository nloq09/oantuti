# Copy to .env.production at repo root; never commit the filled file.
COMPOSE_PROJECT_NAME=rpsbattle
POSTGRES_DB=rpsbattle
POSTGRES_USER=rpsuser
POSTGRES_PASSWORD=
DB_USERNAME=rpsapp
DB_PASSWORD=
RPS_DOMAIN=game.example.com
ACME_EMAIL=you@example.com
RPS_IMAGE=rps-battle:local
RPS_SUBNET=172.30.90.0/24
HTTP_PORT=80
HTTPS_PORT=443
BIND_ADDRESS=0.0.0.0
# Docker socket group on Linux: stat -c '%g' /var/run/docker.sock
DOCKER_GID=0
MAX_CONCURRENT_MATCHES=4
MAX_PENDING_MATCHES=256
RATE_LIMIT_MULTIPLIER=1
